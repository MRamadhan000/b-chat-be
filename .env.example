# Application port: Port tempat aplikasi NestJS berjalan (default 3001)
PORT=

# Optional TypeORM flag for development: Flag untuk sync database secara manual (tidak digunakan, digantikan NODE_ENV)
TYPEORM_SYNCHRONIZE=

# Database configuration
# NODE_ENV: Mode environment (development/production). Jika development, synchronize=true; production=false
NODE_ENV=

# DB_HOST: Host server database PostgreSQL (localhost untuk local)
DB_HOST=

# DB_PORT: Port database PostgreSQL (5433 untuk menghindari konflik)
DB_PORT=

# DB_USERNAME: Username untuk connect ke database
DB_USERNAME=

# DB_PASSWORD: Password untuk connect ke database
DB_PASSWORD=

# DB_NAME: Nama database yang digunakan
DB_NAME=

# JWT_SECRET: Secret key untuk JWT token
JWT_SECRET=